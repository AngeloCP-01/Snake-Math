    "semantic": {
      "bg.home.center": "{forest-800}",
      "bg.home.edge": "{forest-900}",
      "bg.game": "{forest-900}",
      "bg.vignette": "{forest-950}",
      "bg.foliage.far": "{foliage-600}",
      "bg.foliage.near": "{foliage-500}",
