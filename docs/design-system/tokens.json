      "surface.card": "{panel-900}",
      "surface.border": "{panel-line}",
      "surface.border.accent": "{leaf-400}",
      "text.primary": "{cream-100}",
      "text.title": "{cream-title}",
      "text.accent": "{lime-text}",
      "text.number": "{gold-300}",
      "text.onPrimary": "{ink-800}",
      "text.outline": "{ink-900}",
      "action.primary.top": "{lime-300}",
      "action.primary.bottom": "{lime-600}",
      "action.primary.lip": "{lime-lip}",
      "action.icon.fill": "#197126",
      "action.icon.ring": "#50A037",
      "action.icon.glyph": "{cream-50}",
      "status.life": "{red-500}",
      "status.lifeLost": "rgba(247,242,187,0.25)",
      "status.correct": "{lime-300}",
      "status.wrong": "{red-500}",
      "board.field": "#01411E",
      "board.grid": "#0D5426",
      "board.frame": "{leaf-400}",
      "board.frameShade": "{foliage-500}",
      "board.frameHighlight": "{leaf-300}"
    },
    "illustration": {
      "snake.$status": "PROVISIONAL — tracks docs/assets/game/snake-assembly-prototype.html; gameplay art in progress",
      "snake.shadow": "rgba(0,29,20,0.5)",
      "snake.outline": "#174C03",
      "snake.fillTop": "#BEEF00",
      "snake.fillMid": "#A5DC00",
      "snake.fillBottom": "#78B700",
      "snake.highlight": "rgba(220,255,97,0.33)",
      "snake.spotA": "#448E06",
      "snake.spotB": "#65A700",
      "snake.tailFill": "#9DD400",
      "snake.tailHighlight": "#D8F75A",
      "apple.body": "{red-600}",
      "apple.shade": "{red-700}",
      "apple.highlight": "{red-300}",
      "apple.leaf": "{foliage-500}",
      "apple.number": "{cream-50}",
