{
  "$description": "Snake & Math design tokens. Source of truth: docs/assets/mockups/home-v3.png and mdas-gameplay-v3.png. Colors sampled from those mockups; sizes in dp/sp for a 390dp-wide phone.",
  "version": "1.0.0",
  "color": {
    "raw": {
      "forest-950": "#03200F",
      "forest-900": "#023E21",
      "forest-800": "#08502B",
      "forest-700": "#155E2B",
      "foliage-600": "#227C28",
      "foliage-500": "#429E27",
      "leaf-400": "#58B437",
      "leaf-300": "#6CBE3B",
      "panel-900": "#023814",
      "panel-800": "#053F1C",
      "panel-line": "#195C20",
      "lime-200": "#CCF151",
      "lime-300": "#C1EB43",
      "lime-400": "#B1E630",
      "lime-500": "#9EDE1E",
      "lime-600": "#95DC18",
      "lime-lip": "#3C851B",
      "lime-text": "#A6DA24",
      "ink-900": "#03371F",
      "ink-800": "#03481A",
      "cream-50": "#FCFAC3",
      "cream-100": "#F7F2BB",
