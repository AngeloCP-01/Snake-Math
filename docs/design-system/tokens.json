  "gradient": {
    "bg.home": "radial(center 50% 40%, {forest-800} 0%, {forest-900} 70%, {forest-950} 100%)",
    "action.primary": "linear(180deg, {lime-300} 0%, {lime-400} 40%, {lime-500} 75%, {lime-600} 100%)",
    "title.lime": "linear(180deg, {lime-200} 0%, {lime-400} 50%, {lime-500} 100%)",
    "title.cream": "linear(180deg, #FFFBE6 0%, {cream-title} 100%)",
    "trophy": "linear(180deg, #FFE45C 0%, #FCCD20 50%, {gold-500} 100%)"
  },
  "typography": {
    "family": {
      "display": "Baloo 2 (ExtraBold 800) — logo, buttons, labels, numbers, math",
      "body": "Nunito (Bold 700) — subtitle, helper copy"
    },
    "scale": {
      "logo.home": {
        "family": "display",
        "size": 64,
        "lineHeight": 60,
        "case": "upper",
        "stroke": "6dp {ink-900}",
        "shadow": "0 4dp {ink-900}"
      },
      "logo.compact": {
        "family": "display",
        "size": 26,
        "lineHeight": 24,
        "case": "upper",
        "stroke": "3dp {ink-900}"
      },
      "math.expression": {
        "family": "display",
        "size": 50,
        "lineHeight": 54,
        "tracking": 0.02
      },
      "button.primary": {
        "family": "display",
        "size": 38,
        "lineHeight": 40,
        "case": "upper",
        "tracking": 0.03
      },
      "number.l": {
        "family": "display",
        "size": 34,
        "lineHeight": 36
      },
      "number.m": {
        "family": "display",
        "size": 26,
        "lineHeight": 28
      },
      "title.s": {
        "family": "display",
        "size": 20,
        "lineHeight": 24,
        "case": "upper",
        "tracking": 0.02
      },
      "label.m": {
        "family": "display",
        "size": 17,
        "lineHeight": 20,
        "case": "upper",
        "tracking": 0.03
      },
      "label.s": {
        "family": "display",
        "size": 14,
        "lineHeight": 16,
        "case": "upper",
        "tracking": 0.03
      },
      "body.m": {
        "family": "body",
        "size": 17,
        "lineHeight": 22
      },
      "apple.number": {
        "family": "display",
        "size": "0.5 × cell",
        "stroke": "0.06 × cell {apple.numberOutline}"
      }
    }
  },
  "spacing": {
    "xxs": 4,
    "xs": 8,
    "s": 12,
    "m": 16,
    "l": 20,
    "xl": 24,
    "xxl": 32,
    "xxxl": 40,
    "screenGutter": 16
  },
  "radius": {
    "s": 12,
    "m": 16,
    "l": 20,
    "xl": 24,
    "board": 24,
    "pill": 999,
    "circle": "50%"
  },
  "stroke": {
    "panel": 2,
    "chip": 2,
    "iconRing": 3,
    "boardFrame": 6,
    "illustrationOutline": 3
  },
  "elevation": {
    "primaryLip": "0 6dp 0 {lime-lip}",
    "primaryLipPressed": "0 2dp 0 {lime-lip} (translateY 4dp)",
    "panel": "0 6dp 14dp rgba(0,0,0,0.30) + inset 0 0 0 4dp rgba(0,0,0,0.15)",
    "floating": "0 10dp 22dp rgba(0,0,0,0.35)",
    "board": "0 8dp 20dp rgba(0,0,0,0.35)"
  },
  "size": {
    "touchMin": 48,
    "button.primary": {
      "width": 296,
      "height": 64
    },
    "button.secondary": {
      "minWidth": 136,
      "height": 48,
      "icon": 26
    },
    "button.icon": {
      "size": 52,
      "glyph": 26
    },
    "panel.bestScore": {
      "width": 270,
      "height": 78,
      "icon": 48
    },
    "panel.score": {
      "height": 60,
      "minWidth": 168
    },
    "chip.mode": {
      "height": 40
    },
    "pill.lives": {
      "height": 40,
      "heart": 26
    },
    "card.question": {
      "minHeight": 96
    },
    "hero.mascot": {
      "width": 300,
      "height": 240
    }
  },
  "board": {
    "targetCell": 44,
    "phoneGrid": "8 × 9 (derived: floor(availableWidth / targetCell))",
    "apple": "1.15 × cell (asset pending)",
    "decorationOpacity": 0.9,
    "decorations": "tufts, small rocks — never on a cell holding the snake or an apple",
    "snakeRendering": {
      "$status": "PROVISIONAL",
      "head": "raster PNG docs/assets/game/snake_head_right_v1.png, faces right, neck anchor (195,675) of 1254px source, visible width ≈ 2 × cell, rotate per direction",
      "body": "continuous Canvas Path through cell centers, turn radius ≈ 0.5 × cell",
      "tail": "tapered tip of the same shape, no image",
      "collision": "grid-based; art never changes hit area"
    }
  },
  "motion": {
    "press": "80ms ease-out",
    "panelEnter": "220ms emphasized-decelerate",
    "applePop": "180ms overshoot (scale 0.6 → 1.08 → 1)",
    "lifeLost": "300ms heart shrink + fade to lifeLost",
    "idleMascot": "blink every 3–5s; tongue flick 400ms"
  }
}